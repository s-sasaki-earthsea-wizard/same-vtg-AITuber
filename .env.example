# OpenAI API設定
OPENAI_API_KEY="your-openai-api-key"

# YouTube配信設定
YOUTUBE_VIDEO_ID="your-youtube-video-id"

# ==============================================================================
# RTMP配信設定 (FFmpeg streaming)
# ==============================================================================
# 本番環境: YouTube Live への配信
YOUTUBE_RTMP_URL="rtmp://a.rtmp.youtube.com/live2"
YOUTUBE_STREAM_KEY="your-stream-key"

# 開発環境: ローカルRTMPサーバーでのテスト
# make up-dev でRTMPサーバーを起動してから以下の設定に切り替えてください
# YOUTUBE_RTMP_URL="rtmp://rtmp-server:1935/live"
# YOUTUBE_STREAM_KEY="test"

# ==============================================================================
# Optional: Custom background image for stream (default: /app/assets/images/background.png)
# STREAM_BACKGROUND_IMAGE="/app/assets/images/custom_background.png"